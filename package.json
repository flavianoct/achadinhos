{
  "name": "achadinhos-bot",
  "version": "0.2.0",
  "description": "Robô de ofertas com link de afiliado: posta no Telegram e mantém um blog escrito por IA, rodando de graça no GitHub",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts --abrir",
    "teste": "node --disable-warning=ExperimentalWarning src/index.ts --teste --abrir",
    "uma-vez": "node --disable-warning=ExperimentalWarning src/index.ts --uma-vez",
    "checar": "node --disable-warning=ExperimentalWarning src/index.ts --checar",
    "blog": "node --disable-warning=ExperimentalWarning src/index.ts --blog",
    "nuvem": "node --disable-warning=ExperimentalWarning src/index.ts --nuvem",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.35.5"
  }
}
