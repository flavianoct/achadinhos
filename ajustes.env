# ============================================================
#  Ajustes do robô no modo nuvem (GitHub Actions).
#  Este arquivo é público: NÃO coloque chaves aqui.
#  As chaves ficam em Settings → Secrets and variables → Actions.
#  Para mudar um ajuste, edite este arquivo no GitHub e salve.
# ============================================================

# ---------- Lojas ----------
SHOPEE_ATIVO=0
# Buscas extras na Shopee, separadas por vírgula (opcional).
SHOPEE_PALAVRAS=
SHOPEE_PAGINAS=2
ML_ATIVO=1
ML_PAGINAS=5
AMAZON_ATIVO=0

# ---------- Filtro de ofertas ----------
DESCONTO_MINIMO=25
QUEDA_MINIMA=10
PRECO_MINIMO=15
PRECO_MAXIMO=5000
NOTA_MINIMA=4.5
VENDAS_MINIMAS=50
PALAVRAS_BLOQUEADAS=réplica,replica,usado,recondicionado,erótico
DIAS_SEM_REPETIR=7

# ---------- Telegram ----------
# O robô roda a cada meia hora. Quantas ofertas postar em cada rodada:
POSTS_POR_RODADA=2
# Horário permitido para postar (hora de Brasília) e limite por dia.
HORA_INICIO=8
HORA_FIM=23
MAX_POSTS_POR_DIA=60

# ---------- Blog ----------
BLOG_ATIVO=1
BLOG_NOME=Achadinhos do Dia
# Quem escreve os posts: github (IA gratuita do GitHub) ou nenhuma (texto padrão).
BLOG_IA=gemini
GEMINI_MODELO=gemini-3.8-flash
GITHUB_MODELO=openai/gpt-4o-mini
# Quantos dias um post fica no ar antes de ser apagado.
BLOG_DIAS_NO_AR=60
# Link do canal mostrado no blog. Em branco = usa o canal do Telegram, se ele tiver @nome.
BLOG_TELEGRAM=


INSTAGRAM_ATIVO=1
# Limites contra spam: publicações por dia e intervalo mínimo (em minutos) entre elas.
INSTAGRAM_FEED_POR_DIA=3
INSTAGRAM_STORIES_POR_DIA=6
INSTAGRAM_INTERVALO_FEED_MIN=180
INSTAGRAM_INTERVALO_STORY_MIN=60
INSTAGRAM_TOKEN_DATA=2026-10-03
