# ============================================================
#  Ajustes do robô no modo nuvem (GitHub Actions).
#  Este arquivo é público: NÃO coloque chaves aqui.
#  As chaves ficam em Settings → Secrets and variables → Actions.
#  Para mudar um ajuste, edite este arquivo no GitHub e salve.
# ============================================================



# ---------- Lojas ----------
SHOPEE_ATIVO=1
# Buscas extras na Shopee, separadas por vírgula (opcional).
SHOPEE_PALAVRAS=
# Quantas buscas por palavra a Shopee faz por rodada, em rodízio (as suas, o TEMA ou uma lista padrão de assuntos). 0 = só o ranking de afiliados.
SHOPEE_BUSCAS_POR_RODADA=2
SHOPEE_PAGINAS=2
ML_ATIVO=1
# Páginas de ofertas lidas por rodada, no total (cerca de 48 produtos cada).
ML_PAGINAS=3
# Quantas dessas páginas vão para as ofertas por categoria, em rodízio (0 = só a vitrine geral).
# Não aumenta o total de pedidos: com 5 e 2, são 3 páginas gerais e 2 de categoria.
ML_PAGINAS_DE_CATEGORIA=1
# Quantas categorias (ou subcategorias) a API do Mercado Livre lê por rodada, em rodízio. A API é o caminho principal; a página de ofertas só entra se ela falhar.
ML_API_CATEGORIAS_POR_RODADA=10
# Buscas por palavra no Mercado Livre por rodada, só dos nichos com canal ou grupo próprio (hoje, pet). 0 = nenhuma.
ML_BUSCAS_DE_NICHO=2
# Categorias do rodízio: Eletrônicos, Celulares, Informática, Eletrodomésticos, Casa, Games, Beleza, Esportes.
# As categorias do Mercado Livre vêm dos nichos (src/nichos.ts). Para listar as suas, tire o # e escreva os IDs: ML_CATEGORIAS=MLB1071,MLB1384
# ML_CATEGORIAS=,MLB1071,MLB1384,MLB1430,MLB263532
AMAZON_ATIVO=0

# ---------- Filtro de ofertas ----------
DESCONTO_MINIMO=25
QUEDA_MINIMA=10
PRECO_MINIMO=15
PRECO_MAXIMO=5000
NOTA_MINIMA=4.5
VENDAS_MINIMAS=50
# 1 = reprova o produto que já esteve mais barato no último mês. 0 = vale a promoção do dia, mesmo que o preço já tenha sido menor.
PRECO_JA_MAIS_BARATO_REPROVA=0
# A Shopee entra com a febre do momento: só os produtos mais vendidos (o padrão é o mesmo VENDAS_MINIMAS).
SHOPEE_VENDAS_MINIMAS=1000
# Fatia de cada loja nos posts: o Mercado Livre (maior comissão) é o carro-chefe. Vazio = as lojas se alternam.
LOJA_PROPORCAO=mercadolivre=65,shopee=35
# Pontuação mínima para a oferta ir para os canais (0 = tudo entra). As fracas continuam só no blog. 58 deixa passar as ~49% melhores; 62, as ~40%.
PONTOS_MINIMOS=58
# Se a fila ficar com menos ofertas que isso por causa do corte, as melhores das fracas entram: o robô nunca fica parado.
FILA_MINIMA=12
# Produtos que vendem muito mas não empolgam num grupo de ofertas (higiene, limpeza, saúde de nicho). Tire uma palavra da lista para liberar.
PALAVRAS_SEM_APELO=geriátrica,geriatrica,geriátrico,incontinência,incontinencia,absorvente,papel higiênico,papel higienico,papel toalha,detergente,sabão em pó,sabao em po,amaciante,desinfetante,água sanitária,agua sanitaria,cotonete,curativo
PALAVRAS_BLOQUEADAS=réplica,replica,usado,recondicionado,erótico
DIAS_SEM_REPETIR=7

# ---------- Telegram ----------
# O robô roda a cada meia hora. Quantas ofertas postar em cada rodada:
POSTS_POR_RODADA=4
# Horário permitido para postar (hora de Brasília) e limite por dia.
HORA_INICIO=7
HORA_FIM=23
# Não repete o mesmo tipo de produto (ex.: 3 chapas de policarbonato de vendedores diferentes) por tantas horas. 0 desliga.
PARECIDOS_HORAS=24
# Tema: o robô só coleta e posta ofertas com uma destas palavras no título (separadas por vírgula). Vale até você apagar. Ex.: celular, smartphone
TEMA=
# Com 4 posts por rodada e uma rodada a cada ~27 minutos, o dia inteiro (7h às 23h) chega perto de 140 posts; abaixo disso o robô para no meio da tarde.
MAX_POSTS_POR_DIA=150

# ---------- Blog ----------
BLOG_ATIVO=1
BLOG_NOME=Mata Preço
# Quem escreve os posts: github (IA gratuita do GitHub) ou nenhuma (texto padrão).
BLOG_IA=gemini
GEMINI_MODELO=gemini-3.8-flash
GITHUB_MODELO=openai/gpt-4o-mini
# Quantos dias um post fica no ar antes de ser apagado.
BLOG_DIAS_NO_AR=60
# Link do canal mostrado no blog. Em branco = usa o canal do Telegram, se ele tiver @nome.
BLOG_TELEGRAM=
# Perfil do Instagram mostrado no blog ("Siga no Instagram"). Pode ser o @ ou o endereço. Em branco = não mostra.
BLOG_INSTAGRAM=mataprecooficial
# Canal do WhatsApp mostrado no blog e na bio ("Receba no WhatsApp"). Em branco = não mostra.
BLOG_WHATSAPP=https://whatsapp.com/channel/0029VbDtCLD2UPBAGBZ4UO1W
# Onde o enviador de WhatsApp posta: links de CANAL (whatsapp.com/channel/...) e de GRUPO (chat.whatsapp.com/...), separados por vírgula.
# Para um grupo, o número do enviador precisa ser membro (adicione o número ao grupo). Mudou aqui, o enviador pega em até 10 minutos, sem reiniciar.
# Duas linhas no fim de cada oferta do WhatsApp (Telegram e Instagram), para quem quiser seguir também. 0 = tira.
WHATSAPP_RODAPE=1
# Quantas ofertas de cada rodada entram na fila do WhatsApp (canal e grupo): as melhores. O Telegram posta todas as da rodada (POSTS_POR_RODADA).
# 2 mantém o ritmo que o WhatsApp já tinha. Quando tiver um chip só do robô, suba aos poucos. 0 = sem limite.
WHATSAPP_POR_RODADA=4
# Ritmo do enviador do WhatsApp (o robô publica isto e o enviador obedece, sem mexer na VPS; o enviador pega em até 1 minuto):
# máximo de mensagens por hora, espera aleatória entre uma e outra (segundos) e idade máxima da oferta (minutos): oferta mais velha que isso é DESCARTADA,
# então o WhatsApp só recebe as mais recentes (a fila atrasada nunca manda coisa velha).
# Mais mensagens por hora e esperas curtas fazem a fila andar mais rápido, mas aumentam o risco de o WhatsApp barrar o número: se acontecer, volte para 6.
WHATSAPP_MAX_POR_HORA=14
WHATSAPP_ESPERA_MIN_SEG=60
WHATSAPP_ESPERA_MAX_SEG=150
WHATSAPP_IDADE_MAXIMA_MIN=45
# 1 = a oferta mais nova sai primeiro (a fila acumulada não atrasa o que acabou de chegar). 0 = da mais antiga para a mais nova.
WHATSAPP_MAIS_NOVA_PRIMEIRO=1
# Convites para o canal: algumas vezes por dia, em horários sorteados, o Telegram convida para o canal do WhatsApp e o WhatsApp convida
# para o canal do Telegram, com uma mensagem diferente a cada vez (saudação da hora e as vantagens do canal). 0 = desliga.
CONVITE_ATIVO=1
# Quantos convites por dia, de 0 a 6. Eles se espalham pelo horário de postagem.
CONVITES_POR_DIA=3
WHATSAPP_DESTINOS=https://whatsapp.com/channel/0029VbDtCLD2UPBAGBZ4UO1W,https://chat.whatsapp.com/KRJ3OtHhmZ10XfReNMTIaw


# Instagram da marca Mata Preço: as artes não mostram preço (a pergunta "Caiu mesmo?" e a faixa "O preço está no grupo").
# Ligado no formato Mata Preço (artes sem preço). 0 = pausa tudo no Instagram.
INSTAGRAM_ATIVO=1
# Limites contra spam: publicações por dia e intervalo mínimo (em minutos) entre elas.
INSTAGRAM_FEED_POR_DIA=2
INSTAGRAM_STORIES_POR_DIA=5
INSTAGRAM_INTERVALO_FEED_MIN=180
INSTAGRAM_INTERVALO_STORY_MIN=60
# Só vão para o Instagram produtos bem avaliados, muito vendidos e sem cara de genérico.
INSTAGRAM_NOTA_MINIMA=4.6
INSTAGRAM_VENDAS_MINIMAS=300
INSTAGRAM_PALAVRAS_BLOQUEADAS=generico,paralelo,similar,replica,imitacao,sem marca,inspirado,primeira linha
# Carrossel do dia: só a dica educativa "Antes de comprar [produto]" (para salvar e comentar), sem preço, no máximo um por dia
# (conta como post de feed) e sem repetir o assunto por 14 dias. 0 desliga. O "Top 5 até R$ X" saiu: ele mostrava preço.
INSTAGRAM_CARROSSEL_POR_DIA=1
# Os dois ajustes abaixo servem à escolha dos produtos do Reel (o teto de preço é só um filtro interno, não aparece na arte).
INSTAGRAM_CARROSSEL_ITENS=5
INSTAGRAM_CARROSSEL_TETOS=50,100,200
# Dias da semana (0 = domingo ... 6 = sábado) em que o carrossel da dica sai. Nos outros dias não há carrossel.
# Padrão: terça, quinta e sábado.
INSTAGRAM_DICAS_DIAS=
# Horários de publicação (hora de Brasília, 0 a 23). O robô só publica nessas horas: assim os posts caem quando o público
# está online, em vez de saírem todos na primeira rodada do dia. Vazio = qualquer hora do horário de postagem.
# Estes são palpites razoáveis (almoço, fim da tarde e noite). Para usar o SEU melhor horário, abra o Instagram:
# Painel profissional → Insights → Total de seguidores → Horários mais ativos, e troque os números abaixo.
INSTAGRAM_HORARIOS_FEED=12,20
INSTAGRAM_HORARIOS_STORIES=9,11,15,17,19
# Reel do dia (vídeo vertical de uns 17 segundos: "Caiu mesmo? 3 achados de hoje", sem preço, com trilha sintetizada). 0 desliga. Sai nas horas abaixo (Brasília).
INSTAGRAM_REELS_POR_DIA=3
# "Comenta QUERO": o post pede para comentar e o robô manda o link no direct de quem comentou (precisa das permissões
# instagram_business_manage_comments e instagram_business_manage_messages no token; sem elas, desliga sozinho e avisa). 0 desliga.
INSTAGRAM_COMENTA_QUERO=1
# Reel animado com o Remotion (pasta remotion/). Se falhar, o robô monta o Reel simples. 0 = sempre o simples.
REEL_REMOTION=1
# Reels de destaque: um produto só, de preferência com várias fotos do anúncio (viram galeria), e "comenta EU QUERO" no fim.
# Quantos dos Reels do dia são de destaque (os outros são de 3 achados) e de quais nichos (todos = qualquer um; ex.: moda,beleza).
INSTAGRAM_REELS_DE_DESTAQUE=3
INSTAGRAM_DESTAQUE_NICHOS=todos
INSTAGRAM_HORARIOS_REELS=13,18,21
# Quiz "Preço certo" nos Reels: o ÚLTIMO Reel do dia (QUIZ_POR_DIA) vira um quiz com 3 produtos, 3 preços (A, B, C), contagem 3-2-1 e a
# revelação com o preço de hoje. Desligado (0) até você aprovar o vídeo de exemplo. 1 = liga.
QUIZ_ATIVO=0
# De quais lojas vêm os produtos do quiz. Só a Shopee por padrão: o preço dela vem direto da API (o do Mercado Livre pode diferir da página).
QUIZ_LOJAS=shopee
# Quantos dos Reels do dia viram quiz (os últimos do dia) e em quais dias da semana (0 = domingo ... 6 = sábado).
QUIZ_POR_DIA=1
QUIZ_DIAS=0,1,2,3,4,5,6
# O formato do quiz em cada dia da semana (domingo, segunda, terça, quarta, quinta, sexta, sábado):
#   preco   = "Preço certo": 3 produtos, 3 preços (A, B, C) e a revelação;
#   sombra  = "Que produto é esse?": a silhueta do produto (só com foto de fundo branco; sem foto assim, vira preco);
#   prefere = "Qual você prefere?": 2 produtos em tela dividida (A x B) e os dois preços no fim.
QUIZ_FORMATOS=preco,preco,preco,preco,preco,preco,preco
# Seu chat privado com o bot (ID numérico: mande /start para o bot e pergunte o ID ao @userinfobot). Quando o quiz sai no Instagram, o robô
# manda o vídeo pronto e a legenda para este chat, e você posta no TikTok e nos Shorts. Vazio = não envia.
QUIZ_ENVIAR_PARA=
# Vitrine do grupo (o Instagram vende o grupo, nunca o preço):
# Story "Hoje no grupo" (quantos achados o grupo recebeu hoje, o maior desconto em %, os de menor preço e fotos),
# uma vez por dia a partir desta hora (Brasília). 0 desliga.
INSTAGRAM_RESUMO_HORA=10
# Carrossel "Por que entrar no grupo" (o que o grupo entrega, com os números da semana), no máximo um por semana,
# nos dias marcados (0 = domingo ... 6 = sábado). Bom para fixar no perfil. Vazio = nunca. Padrão: segunda.
INSTAGRAM_GRUPO_DIAS=
# Dias do carrossel "A ou B?" (formato antigo): vazio = nunca.
INSTAGRAM_PERGUNTA_DIAS=
INSTAGRAM_TOKEN_DATA=2026-10-27

# ---------- Canais por nicho (opcional) ----------
# Cada oferta é classificada automaticamente em um nicho: tech (Eletrônicos), games, moda, casa (Casa & Cozinha),
# esporte, beleza, bebe, pet, ferramentas ou geral. Sem nenhuma rota, tudo vai para o canal de TELEGRAM_CHAT_ID.
# Para mandar um nicho para um canal próprio, liste "nicho=canal", separados por vírgula. O bot precisa ser
# administrador de cada canal. Nicho sem rota continua indo para o canal geral. Exemplo:
# ROTAS_TELEGRAM=tech=@meucanaltech,moda=@meucanalmoda,casa=-1001234567890
ROTAS_TELEGRAM=
# 1 = a oferta de um nicho com canal próprio também sai no canal geral.
ROTAS_TAMBEM_NO_GERAL=1
# Filtro do canal geral. GERAL_NICHOS: só estes nichos entram no geral (vazio = todos).
# GERAL_SEM_NICHOS: estes nichos nunca entram no geral. Oferta de um nicho sem canal próprio que o geral
# não aceita não é postada no Telegram (continua no blog). Exemplo: GERAL_SEM_NICHOS=bebe,pet
GERAL_NICHOS=
GERAL_SEM_NICHOS=
# Quantos anúncios por dia o canal geral recebe de um nicho que tem canal ou grupo próprio ("nicho=número"). O resto do dia vai só
# para o grupo do nicho. A cota cresce ao longo do dia (ex.: 2 por dia = um de manhã e outro à tarde). Exemplo: GERAL_LIMITES=pet=2,bebe=2 (0 ou sem a linha = sem limite).
GERAL_LIMITES=pet=2
# Grupos e canais de WhatsApp de um nicho: "nicho=link", separados por vírgula (um nicho pode ter vários).
# Recebem só as ofertas do nicho. Os de WHATSAPP_DESTINOS são gerais e seguem o filtro do geral acima.
# Exemplo: WHATSAPP_ROTAS=moda=https://chat.whatsapp.com/XXXX,tech=https://whatsapp.com/channel/YYYY
WHATSAPP_ROTAS=pet=https://chat.whatsapp.com/KJi6FhpMfda0s0phA5W3Y3
# Máximo de posts por dia de cada nicho (0 = sem limite), para um nicho não ocupar o dia todo.
NICHO_MAX_POR_DIA=0
# Os nichos que o robô busca e posta. Vazio = todos. Para puxar só um (ou alguns): NICHOS_ATIVOS=pet ou NICHOS_ATIVOS=pet,bebe
# Vale para a Shopee (categorias e buscas) e para o Mercado Livre. Nichos: tech, casa, games, beleza, moda, esporte, pet, bebe, ferramentas.
NICHOS_ATIVOS=
# Shopee por categoria: quantas categorias ler por rodada, e quantas a mais dos nichos que têm canal ou grupo próprio.
SHOPEE_CATEGORIAS_POR_RODADA=3
SHOPEE_CATEGORIAS_DE_NICHO=1
# Cada nicho tem as suas regras. Nicho pequeno tem menos oferta, então ganha um corte de qualidade menor (o de todos é o PONTOS_MINIMOS).
NICHO_PONTOS_MINIMOS=pet=48,bebe=48,ferramentas=48,games=52
# Mínimo de posts por dia de cada nicho, distribuído ao longo do dia (ex.: NICHO_MINIMOS=pet=8,bebe=4). Vazio = só o padrão abaixo.
NICHO_MINIMOS=pet=48,moda=16
# Mínimo diário dos nichos que têm canal ou grupo próprio e não aparecem acima.
NICHO_MINIMO_PADRAO=6
# Quantas ofertas cada nicho com canal ou grupo próprio mantém na fila (entram as melhores das fracas se faltar).
NICHO_FILA_MINIMA=3
# Buscas extras da Shopee por rodada, só dos nichos com canal ou grupo próprio.
SHOPEE_BUSCAS_DE_NICHO=3
# Limite próprio de alguns nichos, que vale mais que o de cima. Exemplo: NICHO_LIMITES=moda=8,tech=15
NICHO_LIMITES=
# Palavras do classificador sem mexer no código: NICHO_PALAVRAS_<NICHO>=palavra,outra,-palavra
# (com "-" na frente, a palavra deixa de contar para o nicho). Nichos: TECH, GAMES, MODA, CASA, ESPORTE,
# BELEZA, BEBE, PET, FERRAMENTAS. Exemplo: NICHO_PALAVRAS_MODA=cropped,biquini,-relogio
NICHO_PALAVRAS_TECH=
NICHO_PALAVRAS_MODA=
NICHO_PALAVRAS_CASA=

# ---------- Shopee: campanhas e vendas ----------
# Campanhas da própria Shopee postadas no canal geral. 0 desliga. Desligado: hoje a API da Shopee só devolve
# páginas de categoria em inglês ("Health", "Women Shoes"), não campanhas; o robô ignora essas páginas.
CAMPANHAS_POR_DIA=0
CAMPANHAS_REPETIR_DIAS=7
# Lê as vendas e a comissão do relatório de afiliados da Shopee para o painel (por nicho).
VENDAS_ATIVO=1
VENDAS_HORAS=3
VENDAS_DIAS=30

# ---------- Datas especiais (10.10, 11.11, Black Friday, Dia das Mães...) ----------
# O robô conhece todas as datas do varejo. Na véspera à noite, na abertura e nas últimas horas ele posta um aviso curto no Telegram, com o link
# da página de ofertas do Mercado Livre (com o seu código). Para a Shopee e para links oficiais de campanha, use o arquivo datas.json (veja o LEIA-ME).
DATAS_ATIVO=1
# Quantos dias antes o painel lembra VOCÊ (só no painel, nunca no canal) de colar o link da campanha e os cupons. 0 = sem lembrete.
DATAS_AVISO_DIAS=3
# Nas datas GRANDES (6.6, 7.7, 9.9, 10.10, 11.11, 12.12, Dia do Consumidor, semanas de Mães, Namorados, Pais, Crianças e Natal, Black Friday),
# o Telegram posta tantos posts A MAIS por rodada (e o limite do dia sobe junto). O WhatsApp não muda. 0 = sem aumento.
DATAS_POSTS_EXTRA=2
# Hora (Brasília) a partir da qual o Instagram publica o Story da data grande do dia. 0 = sem Story de data.
INSTAGRAM_DATA_HORA=0

# ---------- Cupons (Mercado Livre e Shopee) ----------
# Os cupons ficam no arquivo cupons.json (veja o LEIA-ME). O robô só posta cupom dentro da validade.
CUPONS_ATIVO=1
# Quantos cupons postar por dia, no máximo.
CUPONS_POR_DIA=3
# Quantos dias esperar antes de repetir um cupom que ainda vale.
CUPONS_REPETIR_DIAS=3
# Garimpo automático: o robô lê as páginas públicas de cupons do Promobit e só posta o que passa nas travas (cupom com código só se verificado
# pelo site e com código de verdade; cupom de ativar só com data de validade). O link é sempre o seu de afiliado.
CUPONS_GARIMPO=0
# De quais lojas o garimpo pega cupom (mercadolivre, shopee). A Shopee está FORA porque o link da página de cupons dela não levava a lugar nenhum.
# Para voltar: coloque em CUPONS_LINK_SHOPEE um link seu que abra os cupons de verdade (teste no celular) e use CUPONS_LOJAS=mercadolivre,shopee.
CUPONS_LOJAS=mercadolivre,shopee
# O seu link de afiliado da Shopee para a página de cupons (gere em "Links personalizados" no painel de afiliados). Sem ele, a Shopee fica de fora do garimpo.
CUPONS_LINK_SHOPEE=
# Palavras que descartam um cupom (no código ou no título), separadas por vírgula. Ex.: cashback,primeira compra
CUPONS_BLOQUEAR=


# Pinterest: pins verticais (2:3) que levam gente para o grupo e os canais, cada um com uma estratégia (produto, lista, benefícios do canal,
# dica de compra, quiz do preço, silhueta). O robô sempre gera as imagens, a planilha (pins.csv), o feed RSS e a galeria em /pinterest.html.
# Com PINTEREST_TOKEN (Secret) e PINTEREST_BOARD_ID, ele também publica pela API (no máximo 1 por rodada). Veja PINTEREST.md.
PINTEREST_ATIVO=1
PINTEREST_PINS_POR_DIA=5
# Nome do quadro na planilha de envio em massa.
PINTEREST_QUADRO=Achadinhos e ofertas do dia
# ID do quadro para a API (número). Vazio = só gera os arquivos.
PINTEREST_BOARD_ID=
# Código da meta tag para reivindicar o site no Pinterest (só as letras e números do content="...").
PINTEREST_VERIFICACAO=53f46d49846afe7d893fc4ff3f70d393
# 1 = usa o ambiente de testes da API (api-sandbox), enquanto o app está em acesso de teste.
PINTEREST_SANDBOX=0
