  [".mp .final .alt{color:#FFD9D7}", ".mp .final .alt{color:#FFD9D7}\n.mp .chan{background:transparent;border:2px solid var(--wa);color:#fff;box-shadow:none}.mp .chan small{opacity:.85}.mp .chan:hover{background:rgba(37,211,102,.12)}\n.mp .nogrp{display:grid;grid-template-columns:1.1fr .9fr;gap:28px;align-items:center;background:var(--ink);border:1px solid var(--line);border-radius:28px;padding:40px}\n.mp .pts{list-style:none;display:grid;gap:12px}.mp .pts li{display:flex;gap:12px;font-size:17px;color:#D9D9E0}.mp .pts li::before{content:'✓';color:var(--wa);font-weight:800}\n@media(max-width:860px){.mp .nogrp{grid-template-columns:1fr;padding:26px}}"],
